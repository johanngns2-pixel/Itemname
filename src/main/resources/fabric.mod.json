  "entrypoints": {
    "client": ["dev.itemnames.ItemNamesClient"],
    "modmenu": ["dev.itemnames.ModMenuIntegration"]
  },
  "mixins": ["itemnames.mixins.json"],
  "depends": { "minecraft": "~1.21.11", "fabricloader": ">=0.18.0", "fabric-api": "*", "java": ">=21" }
}
